# Copy to .env and fill in. Every value except the three secrets has a working default
# for local development with `docker compose up -d db` from the repo root.

NODE_ENV=development
PORT=3000
# Set to true when running behind a reverse proxy / load balancer (correct client IPs for rate limiting).
TRUST_PROXY=false

# ---- Database (docker compose publishes Postgres on host port 5433) ----
# DATABASE_URL takes precedence over the DB_* values when set.
# DATABASE_URL=postgres://savemyvote:savemyvote@localhost:5433/savemyvote
DB_HOST=localhost
DB_PORT=5433
DB_USER=savemyvote
DB_PASSWORD=savemyvote
DB_NAME=savemyvote
DB_SSL=false
# Apply pending migrations on startup.
DB_RUN_MIGRATIONS=true
DB_LOGGING=false

# ---- Secrets: at least 32 characters each, all different ----
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_EMAIL_SECRET=
OTP_SECRET=
# Organiser session length in minutes (10080 = 7 days).
JWT_ACCESS_TTL_MINUTES=10080

# ---- URLs ----
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
# Extra allowed CORS origins, comma separated (FRONTEND_URL is always allowed).
CORS_ORIGINS=
# Use "none" when the frontend is served from a different site than the API (requires HTTPS).
COOKIE_SAME_SITE=lax

# ---- Mail (SendByte: https://sendbyte.africa) ----
# API key from the SendByte dashboard > API keys: sk_test_... (simulated, nothing is delivered)
# or sk_live_... Leave empty to print emails to the log instead (local dev).
SENDBYTE_API_KEY=
# Must be an address on a domain you have verified in SendByte (live keys).
MAIL_FROM_ADDRESS=no-reply@savemyvote.local
MAIL_FROM_NAME=SaveMyVote
MAIL_REPLY_TO=

# ---- Image storage (Cloudflare R2) ----
# Candidate photos and election logos. Set all five, or none: with none, uploads go to
# LOCAL_UPLOADS_DIR and are served at BACKEND_URL/uploads (development only; production
# refuses to start without R2). See README > Image storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public address: its custom domain (e.g. https://images.example.com) or r2.dev URL.
R2_PUBLIC_URL=
LOCAL_UPLOADS_DIR=uploads

# ---- UserJot feedback widget (optional) ----
# Both from UserJot > Settings > Login > Secrets. Set both, or neither.
# With them, GET /api/v1/auth/userjot-token signs an identity token, so feedback is tied to the
# organiser who sent it. The project ID matches the frontend's VITE_USERJOT_PROJECT_ID.
USERJOT_PROJECT_ID=
# Secret: never commit it or send it to the browser.
USERJOT_PROJECT_SECRET=

# ---- Google sign-in (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to BACKEND_URL + /api/v1/auth/google/callback (add it to the OAuth client's redirect URIs)
GOOGLE_CALLBACK_URL=

# ---- Voting ----
# Invitations with one-time codes go out this many minutes before an election starts.
OTP_LEAD_MINUTES=60
# Wrong codes allowed before a voter is locked out (the organiser can resend to unlock).
OTP_MAX_ATTEMPTS=5
SCHEDULER_ENABLED=true

# ---- HTTP ----
# Requests per minute per client, for routes without a stricter limit.
THROTTLE_LIMIT=120
SWAGGER_ENABLED=true

# ---- Logging (Winston) ----
# error | warn | info | http | verbose | debug
LOG_LEVEL=info
# Write <LOG_DIR>/app.log (everything) and <LOG_DIR>/error.log (errors only).
# Defaults to true outside production.
LOG_TO_FILES=
LOG_DIR=logs

# ---- Sentry (errors, traces, logs, metrics) ----
# DSN from Sentry > Project Settings > Client Keys. Leave empty to disable Sentry.
SENTRY_DSN=
# Defaults to NODE_ENV.
SENTRY_ENVIRONMENT=
# e.g. the git commit SHA, to tie errors to a deploy.
SENTRY_RELEASE=
# Share of requests traced (0 to 1). Leave empty for 1.0 locally and 0.1 in production.
SENTRY_TRACES_SAMPLE_RATE=
