# Where the browser sends API requests, including the API version. "/api/v1" uses the Vite dev
# proxy (see vite.config.ts), which forwards to the NestJS API on http://localhost:3000.
# For a production build served from another domain, set the full URL, e.g. https://api.example.com/api/v1
VITE_API_URL=/api/v1

# Public contact address shown in the footer, About, Terms and Privacy pages.
# Leave empty to point people to the in-app "Send Feedback" instead.
VITE_CONTACT_EMAIL=

# ---- Sentry (errors, tracing, logs, Session Replay) ----
# DSN of the savemyvote-frontend project (Sentry > Project Settings > Client Keys).
# Leave empty to disable Sentry. A DSN is safe to ship in browser code.
VITE_SENTRY_DSN=
# Defaults to the Vite mode (development / production).
VITE_SENTRY_ENVIRONMENT=
# e.g. the git commit SHA, to tie errors to a deploy.
VITE_SENTRY_RELEASE=
# Share of page loads traced (0 to 1). Leave empty for 1.0 in dev and 0.1 in production builds.
VITE_SENTRY_TRACES_SAMPLE_RATE=

# ---- UserJot (organiser feedback widget) ----
# Project ID from UserJot > Settings > Login > Secrets (or the Share page). Not a secret.
# Leave empty to hide the "Send Feedback" item and skip loading the widget.
VITE_USERJOT_PROJECT_ID=
